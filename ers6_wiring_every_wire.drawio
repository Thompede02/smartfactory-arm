        <mxCell id="Cu48" parent="Cucp" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" value="&lt;b style=&#39;font-size:14px&#39;&gt;Wires crossing each joint&lt;/b&gt;&lt;table style=&#39;font-size:12px;border-collapse:collapse;margin-top:6px&#39;&gt;&lt;tr&gt;&lt;th style=&#39;text-align:left;padding:4px 6px&#39;&gt;Joint&lt;/th&gt;&lt;th style=&#39;padding:4px 6px&#39;&gt;Wires&lt;/th&gt;&lt;th style=&#39;text-align:left;padding:4px 6px&#39;&gt;Cables&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:4px 6px;border-top:1px solid #ccc;white-space:nowrap&#39;&gt;&lt;b&gt;J1&lt;/b&gt; base rotation&lt;/td&gt;&lt;td style=&#39;padding:4px 6px;border-top:1px solid #ccc;text-align:center&#39;&gt;&lt;b&gt;11&lt;/b&gt;&lt;/td&gt;&lt;td style=&#39;padding:4px 6px;border-top:1px solid #ccc&#39;&gt;Mux 3V3+GND (2), SDA+SCL (2), PCA 3V3+GND (2), J1 lead (3), Servo V+ &amp; GND (2)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:4px 6px;border-top:1px solid #ccc;white-space:nowrap&#39;&gt;&lt;b&gt;J2&lt;/b&gt; shoulder&lt;/td&gt;&lt;td style=&#39;padding:4px 6px;border-top:1px solid #ccc;text-align:center&#39;&gt;&lt;b&gt;14&lt;/b&gt;&lt;/td&gt;&lt;td style=&#39;padding:4px 6px;border-top:1px solid #ccc&#39;&gt;Mux 3V3+GND (2), SDA+SCL (2), PCA 3V3+GND (2), J1 lead (3), Servo V+ &amp; GND (2), J2 lead (3)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:4px 6px;border-top:1px solid #ccc;white-space:nowrap&#39;&gt;&lt;b&gt;J3&lt;/b&gt; elbow&lt;/td&gt;&lt;td style=&#39;padding:4px 6px;border-top:1px solid #ccc;text-align:center&#39;&gt;&lt;b&gt;16&lt;/b&gt;&lt;/td&gt;&lt;td style=&#39;padding:4px 6px;border-top:1px solid #ccc&#39;&gt;Mux 3V3+GND (2), SDA+SCL (2), Gripper lead (3), J6 lead (3), J5 lead (3), J4 lead (3)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:4px 6px;border-top:1px solid #ccc;white-space:nowrap&#39;&gt;&lt;b&gt;J4&lt;/b&gt; forearm rotation&lt;/td&gt;&lt;td style=&#39;padding:4px 6px;border-top:1px solid #ccc;text-align:center&#39;&gt;&lt;b&gt;17&lt;/b&gt;&lt;/td&gt;&lt;td style=&#39;padding:4px 6px;border-top:1px solid #ccc&#39;&gt;Mux 3V3+GND (2), SDA+SCL (2), Gripper lead (3), J6 lead (3), J5 lead (3), J4 encoder (4)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:4px 6px;border-top:1px solid #ccc;white-space:nowrap&#39;&gt;&lt;b&gt;J5&lt;/b&gt; wrist tilt&lt;/td&gt;&lt;td style=&#39;padding:4px 6px;border-top:1px solid #ccc;text-align:center&#39;&gt;&lt;b&gt;6&lt;/b&gt;&lt;/td&gt;&lt;td style=&#39;padding:4px 6px;border-top:1px solid #ccc&#39;&gt;Gripper lead (3), J6 lead (3)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:4px 6px;border-top:1px solid #ccc;white-space:nowrap&#39;&gt;&lt;b&gt;J6&lt;/b&gt; wrist rotation&lt;/td&gt;&lt;td style=&#39;padding:4px 6px;border-top:1px solid #ccc;text-align:center&#39;&gt;&lt;b&gt;3&lt;/b&gt;&lt;/td&gt;&lt;td style=&#39;padding:4px 6px;border-top:1px solid #ccc&#39;&gt;Gripper lead (3)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="330" width="560" x="1180" y="100" as="geometry" />
        </mxCell>
        <mxCell id="Cu49" parent="Cucp" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=10;strokeColor=#aaaaaa;fillColor=#ffffff;rounded=1;" value="&lt;b style=&quot;font-size:13px&quot;&gt;Wire colours&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Servo leads&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#f39c12&quot;&gt;━━━&lt;/font&gt; signal (PWM) &amp;nbsp; &lt;font color=&quot;#d62728&quot;&gt;━━━&lt;/font&gt; V+ &amp;nbsp; &lt;font color=&quot;#000000&quot;&gt;━━━&lt;/font&gt; GND&lt;br&gt;&lt;br&gt;&lt;b&gt;Logic, I²C and encoder cables&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#e88b8b&quot;&gt;━━━&lt;/font&gt; 3.3 V &amp;nbsp; &lt;font color=&quot;#000000&quot;&gt;━━━&lt;/font&gt; GND &amp;nbsp; &lt;font color=&quot;#1f6fd1&quot;&gt;━━━&lt;/font&gt; SDA &amp;nbsp; &lt;font color=&quot;#17a2a2&quot;&gt;━━━&lt;/font&gt; SCL&lt;br&gt;&lt;br&gt;&lt;b&gt;Supply&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#d62728&quot;&gt;━━━&lt;/font&gt; all power (servo supply, servo V+, 5 V to Pi) &amp;nbsp; &lt;font color=&quot;#e88b8b&quot;&gt;━━━&lt;/font&gt; 3.3 V logic &amp;nbsp; &lt;font color=&quot;#000000&quot;&gt;━━━&lt;/font&gt; GND&lt;div&gt;&lt;br/&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="185" width="460" x="1180" y="460" as="geometry" />
        </mxCell>
        <mxCell id="Cu50" parent="Cucp" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacing=10;strokeColor=#aaaaaa;fillColor=#fffbe6;rounded=1;" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• SDA and SCL leave the Pi as one pair and split beside the PCA9685 (dots): one branch into the PCA9685, one up to the mux.&lt;br&gt;• The 8 wires through J4 (mux bus + J4 encoder) are the “8-wire rail”. The J5, J6 and gripper leads are the 3×3 servo harness." vertex="1">
          <mxGeometry height="110" width="460" x="1180" y="665" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
