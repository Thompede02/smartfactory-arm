<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ers6">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import ers6 urdf file -->
    <xacro:include filename="$(find ers6_description)/urdf/ers6.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="ers6.ros2_control.xacro" />


    <xacro:ers6_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
