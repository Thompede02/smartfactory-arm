<?xml version="1.0"?>
<robot name="only_base_test">



  <joint name="a5_to_a4" type="fixed">
    <parent link="a5"/>
    <child link="a4"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/> <!-- position relative to a5 -->
  </joint>

  <link name="a4">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/> <!-- tweak orientation -->
      <geometry>
        <mesh filename="../meshes/a4.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
  </link>
</robot>



