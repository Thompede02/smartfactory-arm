    <child link="a3"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 -1 0.0032"/>
    <limit effort="1000" lower="-1" upper="1" velocity="0.5"/>
  </joint>

  <link name="a3">
