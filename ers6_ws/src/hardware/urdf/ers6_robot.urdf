<?xml version="1.0"?>
<robot name="ers6">

  <link name="world"/>

  <joint name="base_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="10 5 0" rpy="-1.5707 0 0"/>
      <geometry>
        <mesh filename="package://ers6_description/meshes/Base.stl" scale="0.005 0.005 0.005"/>
      </geometry>
      <material name="base_link-material">
        <color rgba="0.076 0.0003 0.361 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://ers6_description/meshes/Base.stl" scale="1 1 1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1"/>
      <inertia ixx="0.4" ixy="0" ixz="0" iyy="0.4" iyz="0" izz="0.4"/>
    </inertial>
  </link>

  <joint name="base_link_to_a5" type="revolute">
    <parent link="base_link"/>
    <child link="a5"/>
    <origin xyz="10 5 0" rpy="3.1416 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="1000" lower="-1" upper="1" velocity="0.5"/>
  </joint>

  <link name="a5">
    <visual>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://ers6_description/meshes/a5.stl" scale="0.005 0.005 0.005"/>
      </geometry>
      <material name="a5-material">
        <color rgba="0.223 0.144 1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 2" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://ers6_description/meshes/a5.stl" scale="1 1 1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1"/>
      <inertia ixx="0.4" ixy="0" ixz="0" iyy="0.4" iyz="0" izz="0.4"/>
    </inertial>
  </link>

  <joint name="a5_to_a4" type="revolute">
    <parent link="a5"/>
    <child link="a4"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="1000" lower="-1" upper="1" velocity="0.5"/>
  </joint>

  <link name="a4">
