<?xml version="1.0"?>
<package format="3">
  <name>hardware</name>
  <version>0.0.1</version>
  <description>ERS6 ros2_control driver: PCA9685 servos + TCA9548A + AS5600 encoders</description>
  <maintainer email="you@example.com">You</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>

  <export>
    <hardware_interface plugin="${prefix}/hardware/ers6_system_plugin.xml"/>
  </export>
</package>
