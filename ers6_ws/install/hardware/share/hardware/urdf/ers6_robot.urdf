<robot name="ers6">
  <!-- minimal links/joints just to run control; replace with your real model -->
  <link name="base_link"/>
  <link name="link1"/><link name="link2"/><link name="link3"/>
  <link name="link4"/><link name="link5"/><link name="link6"/>

  <joint name="base_link_to_a5" type="revolute">
    <parent link="base_link"/><child link="link1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-2.62" upper="2.62" effort="5" velocity="3"/>
  </joint>
  <joint name="a5_to_a4" type="revolute">
    <parent link="link1"/><child link="link2"/>
    <origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-2.62" upper="2.62" effort="5" velocity="3"/>
  </joint>
  <joint name="a4_to_a3" type="revolute"><parent link="link2"/><child link="link3"/>
    <origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-2.62" upper="2.62" effort="5" velocity="3"/>
  </joint>
  <joint name="a3_to_a2" type="revolute"><parent link="link3"/><child link="link4"/>
    <origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-2.62" upper="2.62" effort="5" velocity="3"/>
  </joint>
  <joint name="a2_to_a1" type="revolute"><parent link="link4"/><child link="link5"/>
    <origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit lower="-2.62" upper="2.62" effort="5" velocity="3"/>
  </joint>
  <joint name="a1_to_a0" type="revolute"><parent link="link5"/><child link="link6"/>
    <origin xyz="0 0 0" rpy="0 0 0"/><axis xyz="1 0 0"/>
    <limit lower="-2.62" upper="2.62" effort="5" velocity="3"/>
  </joint>

  <ros2_control name="ERS6System" type="system">
    <hardware>
      <plugin>ros2_control_ers6/RobotSystemHardware</plugin>
    </hardware>
    <!-- declare interfaces per joint -->
    <joint name="base_link_to_a5"><command_interface name="position"/><state_interface name="position"/></joint>
    <joint name="a5_to_a4"><command_interface name="position"/><state_interface name="position"/></joint>
    <joint name="a4_to_a3"><command_interface name="position"/><state_interface name="position"/></joint>
    <joint name="a3_to_a2"><command_interface name="position"/><state_interface name="position"/></joint>
    <joint name="a2_to_a1"><command_interface name="position"/><state_interface name="position"/></joint>
    <joint name="a1_to_a0"><command_interface name="position"/><state_interface name="position"/></joint>
  </ros2_control>
</robot>
