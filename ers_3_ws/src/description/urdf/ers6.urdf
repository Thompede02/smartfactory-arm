<?xml version="1.0"?>
<robot name="ers6">

  <link name="world"/>
  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ============ base_link ================ -->
  <link name="base_link">
    <visual>
      <origin xyz="-0.075 0.05 0.0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://description/meshes/Base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="base_link-material">
        <color rgba="0.076 0.0003 0.361 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="-0.075 0.05 0.0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://description/meshes/Base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1"/>
      <inertia ixx="0.4" ixy="0" ixz="0" iyy="0.4" iyz="0" izz="0.4"/>
    </inertial>
  </link>

  <!-- ============== Joint1 =============== -->
  <joint name="Joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="Link_1"/>
    <origin xyz="-0.03 0.0 0.09" rpy="1.5708 0 1.5708"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="1000" velocity="2.0"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

  <!-- ============== Link 1 =============== -->
  <link name="Link_1">
    <visual>
      <origin xyz="-0.05 0 -0.04" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://description/meshes/a5.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="a5-material">
        <color rgba="0.223 0.144 1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="-0.05 0 -0.04" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://description/meshes/a5.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1"/>
      <inertia ixx="0.4" ixy="0" ixz="0" iyy="0.4" iyz="0" izz="0.4"/>
    </inertial>
  </link>

  <!-- ============== Joint 2 ================ -->
  <joint name="Joint_2" type="revolute">
    <parent link="Link_1"/>
    <child link="Link_2"/>
    <origin xyz="0.0 0.06 -0.005" rpy="0 0 1.5708"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="1000" velocity="2.0"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

  <!-- ============== Link 2 =============== -->
  <link name="Link_2">
    <visual>
      <origin xyz="-0.015 -0.04 -0.065" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://description/meshes/a4.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="a4-material">
        <color rgba="0.356 0.658 0.074 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="-0.015 -0.04 -0.065" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://description/meshes/a4.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1"/>
      <inertia ixx="0.4" ixy="0" ixz="0" iyy="0.4" iyz="0" izz="0.4"/>
    </inertial>
  </link>

  <!-- =============== Joint 3 =================== -->
  <joint name="Joint_3" type="revolute">
    <parent link="Link_2"/>
    <child link="Link_3"/>
    <origin xyz="0.18 0.0 -0.0" rpy="1.5708 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-1.5708" upper="1.5708" effort="1000" velocity="2.0"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

  <!-- ============== Link 3 =============== -->
  <link name="Link_3">
    <visual>
      <origin xyz="-0.015 -0.022 -0.032" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://description/meshes/a3.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="a3-material">
        <color rgba="0.855 0.050 0.050 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.032" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://description/meshes/a3.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1"/>
      <inertia ixx="0.4" ixy="0" ixz="0" iyy="0.4" iyz="0" izz="0.4"/>
    </inertial>
  </link>

  <!-- ================== Joint 4 ====================== -->
  <joint name="Joint_4" type="revolute">
    <parent link="Link_3"/>
    <child link="Link_4"/>
    <origin xyz="0.09 0 0.0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="1000" velocity="2.0"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

  <!-- ============== Link 4 =============== -->
  <link name="Link_4">
    <visual>
      <origin xyz="0.185 -0.024 0.03" rpy="0 3.141592654 0"/>
      <geometry>
        <mesh filename="package://description/meshes/a2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="a2-material">
        <color rgba="0.638 0.672 0.880 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://description/meshes/a2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1"/>
      <inertia ixx="0.4" ixy="0" ixz="0" iyy="0.4" iyz="0" izz="0.4"/>
    </inertial>
  </link>

  <!-- ================ Joint 5 ==================== -->
  <joint name="Joint_5" type="revolute">
    <parent link="Link_4"/>
    <child link="Link_5"/>
    <origin xyz="0.17 0 0.0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="1000" velocity="2.0"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

  <!-- ============== Link 5 =============== -->
  <link name="Link_5">
    <visual>
      <origin xyz="-0.02 -0.022 -0.034" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://description/meshes/a1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="a1-material">
        <color rgba="0.198 0.429 0.015 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://description/meshes/a1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1"/>
      <inertia ixx="0.4" ixy="0" ixz="0" iyy="0.4" iyz="0" izz="0.4"/>
    </inertial>
  </link>

  <!-- ================= Joint 6 =================== -->
  <joint name="Joint_6" type="revolute">
    <parent link="Link_5"/>
    <child link="Link_6"/>
    <origin xyz="0.075 0 0.0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="1000" velocity="2.0"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>

  <!-- ====================== Link 6 ====================== -->
  <link name="Link_6">
    <visual>
      <origin xyz="0 0 0.0" rpy="0 1.5708 0"/>
      <geometry>
        <mesh filename="package://description/meshes/a0.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="a0-material">
        <color rgba="0.309 0.002 0.352 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://description/meshes/a0.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1"/>
      <inertia ixx="0.4" ixy="0" ixz="0" iyy="0.4" iyz="0" izz="0.4"/>
    </inertial>
  </link>


  <!-- =================== ros2_control ==================== -->
  <ros2_control name="ERS6System" type="system">
    <hardware>
      <plugin>ros2_control_ers6/RobotSystemHardware</plugin>
    </hardware>

    <joint name="Joint_1">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="Joint_2">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="Joint_3">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="Joint_4">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="Joint_5">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="Joint_6">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

</robot>
