53" target="c79"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c171" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#d62728;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c54" target="c80"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c172" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#222222;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c55" target="c81"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c173" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#e67e22;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c56" target="c83"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c174" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#d62728;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c57" target="c84"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c175" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#222222;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c58" target="c85"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c176" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#e67e22;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c59" target="c87"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c177" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#d62728;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c60" target="c88"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c178" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#222222;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="c61" target="c89"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c179" value="&lt;b&gt;Wire colours&lt;/b&gt;&lt;br&gt;&lt;font color='#222222'&gt;━━&lt;/font&gt; GND&amp;nbsp;&amp;nbsp; &lt;font color='#8e44ad'&gt;━━&lt;/font&gt; 3.3 V logic&amp;nbsp;&amp;nbsp; &lt;font color='#d62728'&gt;━━&lt;/font&gt; 5 V / servo V+&lt;br&gt;&lt;font color='#1f6fd1'&gt;━━&lt;/font&gt; I²C SDA&amp;nbsp;&amp;nbsp; &lt;font color='#17a2a2'&gt;━━&lt;/font&gt; I²C SCL&amp;nbsp;&amp;nbsp; &lt;font color='#e67e22'&gt;━━&lt;/font&gt; servo PWM&amp;nbsp;&amp;nbsp; &lt;font color='#b7950b'&gt;━━&lt;/font&gt; OE&lt;br&gt;Green boxes: GX12 connectors in the base wall. Grey bands: cables leaving the base." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=8;strokeColor=#aaaaaa;fillColor=#ffffff;rounded=1;" vertex="1" parent="1"><mxGeometry x="40" y="1310" width="420" height="80" as="geometry"/></mxCell><mxCell id="c180" value="&lt;b&gt;Star ground:&lt;/b&gt; every GND meets at one point next to the big buck. Servo return current goes straight from the PCA9685 terminal to the star and never through the Pi or the I²C wires. The DDR-30G-5 is isolated, so its output GND only joins the rest through the Pi.&lt;br&gt;&lt;b&gt;OE:&lt;/b&gt; 10 kΩ pull-up to 3V3 keeps all servo outputs off at boot. servo_node.py drives GPIO17 low once the start pose is set.&lt;br&gt;&lt;b&gt;Connectors (GX12):&lt;/b&gt; screw-locking aviation plugs, 2–7 pins, about 5 A per pin. GX12-4 for each encoder cable, GX12-7 for the forearm servos (3 PWM + V+ and GND on two pins each, shared). Never plug or unplug with power on, since pins can touch while mating. Label both halves.&lt;br&gt;&lt;b&gt;Check:&lt;/b&gt; PA-90W output must be within 9–36 V for the DDR-30G-5." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacing=8;strokeColor=#aaaaaa;fillColor=#fffbe6;rounded=1;" vertex="1" parent="1"><mxGeometry x="480" y="1310" width="700" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>